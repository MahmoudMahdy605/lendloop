{
  "name": "LendLoop - Overdue reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "b2f1c0de-0002-4000-8000-000000000001",
      "name": "Every day 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "b2f1c0de-0002-4000-8000-000000000008",
      "name": "Run now (manual / CLI)",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "// Sign the request to Convex (n8n -> Convex direction uses its own secret).\nconst crypto = require('crypto');\nconst body = JSON.stringify({ requestedAt: new Date().toISOString() });\nconst ts = Math.floor(Date.now() / 1000).toString();\nconst signature = 'sha256=' + crypto.createHmac('sha256', $env.LENDLOOP_INBOUND_SECRET).update(`${ts}.${body}`).digest('hex');\nreturn [{ json: { body, ts, signature } }];"
      },
      "id": "b2f1c0de-0002-4000-8000-000000000002",
      "name": "Sign fetch request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_SITE_URL }}/n8n/overdue-loans",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {}
      },
      "id": "b2f1c0de-0002-4000-8000-000000000003",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "fieldToSplitOut": "loans",
        "options": {}
      },
      "id": "b2f1c0de-0002-4000-8000-000000000004",
      "name": "One item per loan",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Mock reminder: logged to the execution, no real email is sent.\nreturn $input.all().map((item) => {\n  const l = item.json;\n  const subject = `Reminder: please return ${l.toolName}`;\n  console.log(`[LendLoop mock reminder] to=${l.borrower.email} subject=\"${subject}\" due=${l.endDate}`);\n  return { json: { loanId: l.loanId, reminderKey: l.reminderKey, to: l.borrower.email, subject } };\n});"
      },
      "id": "b2f1c0de-0002-4000-8000-000000000005",
      "name": "Send reminder (mock)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Signed, idempotent write-back. The reminderKey (overdue:<loanId>:<date>) makes retries update the same row.\nconst crypto = require('crypto');\nreturn $input.all().map((item) => {\n  const body = JSON.stringify({ key: item.json.reminderKey, loanId: item.json.loanId, kind: 'overdue_reminder', status: 'sent' });\n  const ts = Math.floor(Date.now() / 1000).toString();\n  const signature = 'sha256=' + crypto.createHmac('sha256', $env.LENDLOOP_INBOUND_SECRET).update(`${ts}.${body}`).digest('hex');\n  return { json: { body, ts, signature } };\n});"
      },
      "id": "b2f1c0de-0002-4000-8000-000000000006",
      "name": "Sign write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_SITE_URL }}/n8n/automation-status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {}
      },
      "id": "b2f1c0de-0002-4000-8000-000000000007",
      "name": "Record reminder in Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
