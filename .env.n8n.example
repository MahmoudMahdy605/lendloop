# Copy to .env.n8n (git-ignored). Same values must be set on the Convex deployment.

# Convex -> n8n webhook signatures (Convex env: N8N_OUTBOUND_SECRET)
LENDLOOP_OUTBOUND_SECRET=change-me-generate-with-openssl-rand-hex-32

# n8n -> Convex request signatures (Convex env: N8N_INBOUND_SECRET)
LENDLOOP_INBOUND_SECRET=change-me-different-secret

# Convex HTTP actions URL (".convex.site"). For a local Convex backend from Docker:
CONVEX_SITE_URL=http://host.docker.internal:3211

# Encrypts credentials stored in n8n's database
N8N_ENCRYPTION_KEY=change-me-long-random-string
